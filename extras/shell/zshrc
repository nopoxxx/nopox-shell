# nopox-shell: zsh

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups share_history autocd interactive_comments
bindkey -e

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null

# приглашение как панель nopox: user@host ~/путь ❯ — красный ❯, если команда завершилась ошибкой
PROMPT='%B%F{green}%n%f%b%F{8}@%f%B%F{cyan}%m%f%b %F{blue}%~%f %(?.%F{yellow}.%F{red})❯%f '

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ll='ls -lah'
