// Подключение nopox-shell к niri — скопируйте нужное в ~/.config/niri/config.kdl.

// input, layout, cursor, prefer-no-csd и animations генерирует окно настроек (Mod+S)
// из ~/.config/nopox/settings.json. Уберите эти секции из своего config.kdl,
// иначе флаги из config.kdl нельзя будет выключить из настроек.
include "nopox.kdl"

spawn-at-startup "qs"

binds {
    Mod+D hotkey-overlay-title="Menu" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+D hotkey-overlay-title="Run an Application" { spawn "qs" "ipc" "call" "launcher" "apps"; }
    Mod+Shift+W hotkey-overlay-title="Wallpapers" { spawn "qs" "ipc" "call" "wallpaper" "picker"; }
    Mod+S hotkey-overlay-title="Settings" { spawn "qs" "ipc" "call" "settings" "toggle"; }
}

// Терминалы, открытые из меню (install / remove / update и т.п.), — плавающие по центру
window-rule {
    match app-id="^nopox-term$"
    open-floating true
    default-column-width { fixed 960; }
    default-window-height { fixed 600; }
}

// Обои quickshell видны и как фон режима обзора
layer-rule {
    match namespace="^nopox-wallpaper$"
    place-within-backdrop true
}
