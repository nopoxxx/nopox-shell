// Подключение nopox-shell к своему ~/.config/niri/config.kdl вручную (install.sh делает это сам).
//
// 1. Скопируйте стартовый nopox.kdl и сделайте ссылку на клавиши nopox:
//      cp ~/.config/quickshell/extras/niri/nopox.kdl ~/.config/niri/
//      ln -sfn ~/.config/quickshell/extras/niri/nopox-binds.kdl ~/.config/niri/
// 2. Допишите в конец config.kdl две строки ниже.
//
// nopox.kdl — input, layout, cursor, prefer-no-csd, animations, мониторы: его генерирует окно
// настроек (Mod+S). Если в config.kdl есть свои input / layout, флаги оттуда (tap и т.п.)
// настройки выключить не смогут — такие секции лучше убрать.
// nopox-binds.kdl — автозапуск qs, клавиши (Mod+D, Mod+S, …) и правила окон; приходит с обновлениями shell.

include "nopox.kdl"
include "nopox-binds.kdl"
